# Kiwoom REST API credentials.
# Copy this file to .env and fill in values from the Kiwoom REST API portal.

# Use real for 실전투자, mock for 모의투자.
KIWOOM_ENV=real

KIWOOM_APP_KEY=
KIWOOM_SECRET_KEY=

# Extra safety switch. Keep false until you intentionally enable real orders.
KIWOOM_ALLOW_ORDERS=false
